+            // keep the numbering its files were named with.
+            if (TvdbOrderingIds.IsTvdbOrdering(series.OrderingId))
+            {
+                var episodes = _tvdbOrdering.ApplyOrdering(series.OrderingId, series.TvdbId, tuple.Item2);
